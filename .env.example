# Contract deployment (Hardhat). Prefer the encrypted Hardhat keystore over
# plain environment variables for private keys:
#   npx hardhat keystore set ARC_TESTNET_PRIVATE_KEY
#   npx hardhat keystore set ARC_MAINNET_PRIVATE_KEY
# Never commit a private key, and use a dedicated deployer wallet.

ARC_TESTNET_PRIVATE_KEY=
ARC_MAINNET_PRIVATE_KEY=

# Optional: a dedicated RPC (for example Alchemy) instead of the public one.
ARC_MAINNET_RPC_URL=

# Optional: local solc binary for offline builds (normally leave empty).
SOLC_PATH=
