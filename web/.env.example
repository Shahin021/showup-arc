# ShowUp web app configuration. Copy to .env.local for local development and
# add the same variables in Vercel (Project → Settings → Environment Variables).
# The app refuses to start if the network or contract address is missing, so
# a misconfigured deployment can never silently fall back to testnet values.

# --- Network -----------------------------------------------------------------
# "testnet" (Arc Testnet, chain 5042002) or "mainnet" (Arc, chain 5042).
NEXT_PUBLIC_SHOWUP_NETWORK=testnet

# ShowUpV6 contract deployed on the network above (see the root README).
NEXT_PUBLIC_SHOWUP_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000

# Optional safety check: 5042002 for testnet, 5042 for mainnet. If set and it
# does not match NEXT_PUBLIC_SHOWUP_NETWORK, the app refuses to start.
NEXT_PUBLIC_SHOWUP_CHAIN_ID=5042002

# Optional: "browser" hides Circle and enables browser-wallet event actions.
# Circle credentials are not required in browser mode.
NEXT_PUBLIC_SHOWUP_WALLET_MODE=browser

# --- Circle user-controlled wallets -------------------------------------------
# From the Circle Developer Console. Use a production key and App ID on mainnet.
CIRCLE_API_KEY=
NEXT_PUBLIC_CIRCLE_APP_ID=

# --- Server secrets ------------------------------------------------------------
# At least 32 characters. Generate with: openssl rand -hex 32
SHOWUP_WALLET_AUTH_SECRET=
# Exactly 64 hex characters. Generate with: openssl rand -hex 32
SHOWUP_RECOVERY_SECRET=

# --- Storage -------------------------------------------------------------------
# Created automatically when you connect a Vercel Blob store to the project.
BLOB_READ_WRITE_TOKEN=

# --- Optional: upload caps across all wallets ----------------------------------
# Defaults (20 videos, 100 event uploads) keep media under a 1 GB Blob store.
SHOWUP_MAX_TOTAL_VIDEOS=20
SHOWUP_MAX_TOTAL_EVENT_UPLOADS=100

# --- Testnet upgrade only ----------------------------------------------------------
# Lets users of the earlier testnet site keep their Circle wallet (one-time
# migration) until this ISO date. Never set it on mainnet.
# SHOWUP_LEGACY_MIGRATION_UNTIL=2026-11-15

# --- Build-time contract check ---------------------------------------------------
# Every build checks on-chain that the contract address is a ShowUpV6. Only
# set this to 1 for builds without network access (for example CI).
# SHOWUP_SKIP_CONTRACT_CHECK=1
# Optional RPC for that check (defaults to the public Arc RPC).
# SHOWUP_CHECK_RPC_URL=

# --- Optional: card on-ramp (mainnet only) -------------------------------------
NEXT_PUBLIC_ENABLE_FIAT_ONRAMP=false
NEXT_PUBLIC_FIAT_ONRAMP_URL=
